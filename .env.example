# Django Core Settings
DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=False

# Database Connection (Supabase PostgreSQL — no spaces around =)
# Direct db.*:5432 is IPv6-only. On Windows use the session pooler (IPv4):
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres

# Allowed hosts for local development. On Vercel, VERCEL_URL is added automatically.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2

# Chapa Sandbox API Keys
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Sandbox funding endpoint (/escrow/<id>/sandbox-fund/)
# Set to False in production once real Chapa webhooks are live.
ALLOW_SANDBOX_FUND=True
